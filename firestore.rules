rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function login()   { return request.auth != null; }
    function me()      { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return login() && me().role == 'admin'; }
    function isKades() { return login() && me().role == 'kades'; }
    function isStaff() { return login() && me().role in ['admin', 'kades']; }
    // Akun tidak sedang dibekukan (permanen atau belum lewat masanya)
    function aktif() {
      return me().get('suspend_permanen', false) != true
        && (me().get('suspend_sampai', null) == null
            || me().get('suspend_sampai', null) <= request.time);
    }

    // ── Akun ──
    match /users/{uid} {
      allow read: if login();
      allow create: if login() && request.auth.uid == uid
                    && request.resource.data.role == 'warga';
      // pemilik boleh ubah profil sendiri, tapi TIDAK boleh ubah peran
      allow update: if login() && (
        isAdmin() ||
        (request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'isVerified', 'foto_url', 'dibekukan',
                       'suspend_permanen', 'suspend_sampai', 'suspend_alasan',
                       'suspend_kategori', 'suspend_oleh', 'suspend_at',
                       'suspend_jumlah'])));
      match /notifications/{nid} {
        allow create: if login();
        allow read, update, delete: if login() && request.auth.uid == uid;
      }
    }

    // ── Fitur lama (tetap seperti sebelumnya: cukup login) ──
    // Informasi desa: warga hanya boleh mengajukan (create). Ubah/hapus hanya
    // Admin/Kades, atau pembuatnya sendiri untuk menghapus.
    match /announcements/{id} {
      match /pilih/{uid} {
        allow read: if login();
        allow create, update: if login() && aktif() && uid == request.auth.uid;
        allow delete: if isStaff();
      }
      allow read: if login();
      allow create: if login() && aktif();
      // Kategori sensitif hanya boleh diterbitkan (published) oleh Kepala Desa.
      allow update: if isKades()
        || (login() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['jumlah_suka', 'jumlah_komentar', 'dilihat']))
        // pembuat info mengajukan perubahan (info lama tetap tayang sampai disetujui)
        || (login() && aktif() && resource.data.authorId == request.auth.uid
             && resource.data.status == 'published'
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['revisi', 'revisi_status', 'revisi_catatan'])
             && request.resource.data.revisi_status == 'diajukan')
        // pembuat info mengajukan penghapusan (perlu ACC Admin)
        || (login() && aktif() && resource.data.authorId == request.auth.uid
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['hapus_status', 'hapus_alasan', 'hapus_at'])
             && request.resource.data.hapus_status == 'diajukan')
        || (isAdmin() && !(request.resource.data.status == 'published'
             && request.resource.data.kategori in ['kesehatan', 'ketenagakerjaan', 'bantuan_sosial']));
      allow delete: if isStaff() || (login() && resource.data.authorId == request.auth.uid && resource.data.status != 'published');
      match /suka/{uid} {
        allow read: if login();
        allow create, update: if login() && aktif() && request.auth.uid == uid;
        allow delete: if login() && request.auth.uid == uid;
      }
      match /komentar/{kid} {
        allow read: if login();
        allow create: if login() && aktif() && request.resource.data.uid == request.auth.uid
          && request.resource.data.isi.size() <= 300;
        // reaksi emoji pada komentar: siapa pun yang login, hanya field 'reaksi'
        allow update: if login() && aktif()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reaksi']);
        allow delete: if isStaff() || (login() && resource.data.uid == request.auth.uid);
      }
    }
    // ── Jasa lokal ──────────────────────────────────────────
    // penyedia_jasa : pemilik mengelola profilnya, Admin memverifikasi/memoderasi,
    //                 warga lain hanya boleh menaikkan penghitung (ulasan, dilihat, dll.)
    // pesanan_jasa  : hanya pemesan, penyedia, dan Admin
    function svcDoc(sid) { return get(/databases/$(database)/documents/penyedia_jasa/$(sid)).data; }
    function pesananDoc(pid) { return get(/databases/$(database)/documents/pesanan_jasa/$(pid)).data; }
    function ktpSah() {
      return me().get('isVerified', false) == true
        || (exists(/databases/$(database)/documents/verifikasi_ktp/$(request.auth.uid))
            && get(/databases/$(database)/documents/verifikasi_ktp/$(request.auth.uid)).data.status == 'terverifikasi');
    }

    match /penyedia_jasa/{id} {
      allow read: if login();

      allow create: if login()
        && request.resource.data.uid_penyedia == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.rating_count == 0
        && request.resource.data.unggulan == false
        && request.resource.data.dikunci == false
        && (request.resource.data.ktp_ok == false || ktpSah());

      allow update: if isAdmin()
        // 1) pemilik: ubah profil sendiri (tidak boleh ubah rating/unggulan/kunci)
        || (login() && resource.data.uid_penyedia == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                 'uid_penyedia', 'rating_avg', 'rating_count', 'rating_dist',
                 'aspek_sum', 'aspek_n', 'unggulan', 'peringatan', 'dikunci',
                 'created_at', 'diverifikasi_at'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ktp_ok'])
                || request.resource.data.ktp_ok == false || ktpSah())
            && (request.resource.data.status == resource.data.status
                || (resource.data.get('dikunci', false) == false
                    && ((request.resource.data.status == 'pending'
                         && resource.data.status in ['ditolak', 'aktif'])
                        || (request.resource.data.status in ['aktif', 'nonaktif']
                            && resource.data.status in ['aktif', 'nonaktif'])
                        ))))
            // mengajukan hapus: hanya mengisi kolom hapus_* dengan status 'diajukan'
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['hapus_status', 'hapus_alasan', 'hapus_keputusan', 'hapus_diajukan_at'])
                || (request.resource.data.hapus_status == 'diajukan'
                    && request.resource.data.get('hapus_keputusan', '') == ''))
        // 2) warga lain: hanya penghitung
        || (login() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'rating_avg', 'rating_count', 'rating_dist', 'aspek_sum', 'aspek_n',
             'pesanan_total', 'pesanan_selesai', 'dilihat', 'dihubungi']));

      allow delete: if isAdmin();

      // Ulasan: id dokumen = id pesanan (1 ulasan per pesanan selesai)
      match /reviews/{rid} {
        allow read: if login();
        allow create: if login()
          && request.resource.data.id_pengguna == request.auth.uid
          && request.resource.data.order_id == rid
          && pesananDoc(rid).uid_pemesan == request.auth.uid
          && pesananDoc(rid).service_id == id
          && pesananDoc(rid).status == 'selesai';
        allow update: if isAdmin()
          || (login() && svcDoc(id).uid_penyedia == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['balasan', 'balasan_at']));
        allow delete: if isAdmin();
      }

      // Foto portofolio (dipisah agar daftar jasa tetap ringan)
      match /portofolio/{pid} {
        allow read: if login();
        allow create, update, delete: if login()
          && (svcDoc(id).uid_penyedia == request.auth.uid || isAdmin());
      }
    }

    // Butuh pekerja: lowongan dari warga + lamaran
    match /lowongan_warga/{id} {
      allow read: if login();
      // lowongan baru WAJIB menunggu persetujuan Admin
      allow create: if login() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.get('disetujui', false) == false;
      allow update: if login() && (isAdmin()
        || (resource.data.uid == request.auth.uid
            && resource.data.status != 'blokir'
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.get('disetujui', true) == resource.data.get('disetujui', true)
            && (
              // tutup lowongan / buka lagi (hanya yang pernah disetujui)
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'alasan'])
                && ((request.resource.data.status == 'ditutup'
                      && resource.data.status in ['aktif', 'pending', 'ditolak'])
                    || (request.resource.data.status == 'aktif'
                      && resource.data.status == 'ditutup'
                      && resource.data.get('disetujui', true) == true)))
              // mengajukan hapus (alasan wajib), keputusan hanya Admin
              || (request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['hapus_status', 'hapus_alasan', 'hapus_keputusan'])
                  && request.resource.data.hapus_status == 'diajukan'
                  && request.resource.data.get('hapus_keputusan', '') == '')
              // menambah jumlah pekerja yang diterima
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['diterima'])
              // ubah isi lowongan -> kembali menunggu persetujuan
              || (request.resource.data.status == 'pending'
                  && resource.data.status in ['pending', 'ditolak', 'aktif', 'ditutup'])
            )));
      allow delete: if login() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    match /lamaran_kerja/{id} {
      allow create: if login() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'baru';
      allow read: if login() && (resource.data.uid == request.auth.uid
                    || resource.data.pemberi_uid == request.auth.uid || isAdmin());
      allow update: if login() && (resource.data.pemberi_uid == request.auth.uid || isAdmin());
      allow delete: if login() && (resource.data.uid == request.auth.uid
                    || resource.data.pemberi_uid == request.auth.uid || isAdmin());
    }
    match /pesanan_jasa/{id} {
      allow create: if login()
        && request.resource.data.uid_pemesan == request.auth.uid
        && request.resource.data.uid_penyedia != request.auth.uid
        && request.resource.data.status == 'menunggu';
      allow read: if login() && (resource.data.uid_pemesan == request.auth.uid
                              || resource.data.uid_penyedia == request.auth.uid
                              || isAdmin());
      allow update: if login()
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['uid_pemesan', 'uid_penyedia', 'service_id', 'created_at'])
        && (isAdmin()
            || (resource.data.uid_pemesan == request.auth.uid
                && request.resource.data.status in
                   ['menunggu', 'nego', 'diterima', 'dikerjakan', 'selesai', 'dibatalkan'])
            || (resource.data.uid_penyedia == request.auth.uid
                && request.resource.data.status in
                   ['menunggu', 'nego', 'diterima', 'ditolak', 'dikerjakan',
                    'menunggu_konfirmasi', 'dibatalkan']));
      allow delete: if isAdmin();
    }
    match /chat_rooms/{id} {
      allow read, write: if login();
      match /messages/{mid} {
        allow read: if login();
        allow create: if login() && aktif();
        allow update, delete: if login();   // tandai dibaca + reaksi emoji
      }
    }

    // ── Pengaduan: privat ──
    match /pengaduan/{id} {
      allow create: if login() && request.resource.data.uid_pelapor == request.auth.uid
                    && request.resource.data.status == 'menunggu_review';
      allow read: if login() && (resource.data.uid_pelapor == request.auth.uid || isStaff());
      allow update: if login() && (isStaff() ||
          (resource.data.uid_pelapor == request.auth.uid
           && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['rating', 'ulasan_rating']))
          // pelapor mengubah isi selama belum diproses petugas
          || (resource.data.uid_pelapor == request.auth.uid
              && resource.data.status == 'menunggu_review'
              && request.resource.data.status == 'menunggu_review'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['kategori', 'judul', 'isi', 'foto_urls', 'lat', 'lng', 'tanggal_kejadian',
                             'terlapor', 'alamat', 'rahasia', 'urgensi', 'dampak', 'sudah_lapor_rt', 'harapan']))
          // pelapor membatalkan (riwayat tetap ada)
          || (resource.data.uid_pelapor == request.auth.uid
              && resource.data.status == 'menunggu_review'
              && request.resource.data.status == 'dibatalkan'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'alasan_batal', 'dibatalkan_at'])));
      match /aktivitas/{aid} {
        allow read, create: if login() &&
          (get(/databases/$(database)/documents/pengaduan/$(id)).data.uid_pelapor == request.auth.uid || isStaff());
      }
    }

    // ── Verifikasi identitas (data teks, tanpa foto) ──
    // Berisi foto KTP sementara → hanya pemilik & Admin (Kades tidak perlu).
    match /verifikasi_ktp/{uid} {
      allow read: if login() && (request.auth.uid == uid || isAdmin());
      allow create, update: if login() && (isAdmin() ||
          (request.auth.uid == uid && request.resource.data.status == 'menunggu'));
    }

    // ── Surat online ──
    match /surat/{id} {
      allow create: if login() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'menunggu_review';
      allow read: if login() && (resource.data.uid == request.auth.uid || isStaff());
      allow update: if isStaff()
        // warga mengubah isi pengajuan sebelum disetujui Kades (kembali ke Admin)
        || (login() && resource.data.uid == request.auth.uid
            && resource.data.status in ['menunggu_review', 'pending_kades']
            && request.resource.data.status == 'menunggu_review'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['jenis', 'keperluan', 'tambahan', 'status']))
        // warga membatalkan selama belum ditandatangani
        || (login() && resource.data.uid == request.auth.uid
            && resource.data.status in ['menunggu_review', 'pending_kades', 'terbit']
            && request.resource.data.status == 'dibatalkan'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'dibatalkan_at']));
      // warga menghapus surat yang ditolak/dibatalkan dari riwayatnya
      allow delete: if login() && resource.data.uid == request.auth.uid
                    && resource.data.status in ['ditolak', 'dibatalkan'];
    }
    // Foto profil baru menunggu persetujuan Admin
    match /foto_profil_antri/{uid} {
      allow read: if login() && (request.auth.uid == uid || isAdmin());
      allow create, update: if login() && (
        (request.auth.uid == uid && request.resource.data.status == 'menunggu')
        || isAdmin());
      allow delete: if login() && (request.auth.uid == uid || isAdmin());
    }
    match /surat_verifikasi/{kode} {
      allow read: if isStaff();      // cek keaslian: hanya Admin/Kades
      allow write: if isStaff();
    }
    match /counters/{id} { allow read, write: if isKades(); }

    // ── Polling & agenda ──
    // ── Suara Warga (polling): suara rahasia, hasil lewat penghitung di dokumen ──
    match /polling/{id} {
      allow read: if login();
      allow create, delete: if isStaff();
      // warga hanya boleh menaikkan penghitung SAAT mengirim suaranya (batch dgn dokumen suara)
      allow update: if isStaff()
        || (login() && aktif()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['total', 'hitung', 'per_rw'])
            && request.time < resource.data.tutup
            && existsAfter(/databases/$(database)/documents/polling/$(id)/suara/$(request.auth.uid))
            && !exists(/databases/$(database)/documents/polling/$(id)/suara/$(request.auth.uid)));
      match /suara/{uid} {
        allow read: if login() && request.auth.uid == uid;   // pilihan orang lain rahasia
        allow create: if login() && aktif() && request.auth.uid == uid
          && request.time < get(/databases/$(database)/documents/polling/$(id)).data.tutup;
      }
      match /komentar/{kid} {
        allow read: if login();
        allow create: if login() && aktif() && request.resource.data.uid == request.auth.uid
          && request.resource.data.isi.size() <= 300;
        allow delete: if isStaff() || (login() && resource.data.uid == request.auth.uid);
      }
    }
    match /usulan_polling/{id} {
      allow create: if login() && aktif() && request.resource.data.uid == request.auth.uid;
      allow read: if isStaff() || (login() && resource.data.uid == request.auth.uid);
      allow update: if isStaff()
        || (login() && resource.data.uid == request.auth.uid && resource.data.status == 'baru'
            && request.resource.data.status == 'baru'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['pertanyaan', 'alasan', 'opsi_saran', 'judul', 'isi', 'lokasi', 'waktu_saran']));
      allow delete: if isStaff()
        || (login() && resource.data.uid == request.auth.uid && resource.data.status == 'baru');
    }

    match /usulan_agenda/{id} {
      allow create: if login() && aktif() && request.resource.data.uid == request.auth.uid;
      allow read: if isStaff() || (login() && resource.data.uid == request.auth.uid);
      allow update: if isStaff()
        || (login() && resource.data.uid == request.auth.uid && resource.data.status == 'baru'
            && request.resource.data.status == 'baru'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['pertanyaan', 'alasan', 'opsi_saran', 'judul', 'isi', 'lokasi', 'waktu_saran']));
      allow delete: if isStaff()
        || (login() && resource.data.uid == request.auth.uid && resource.data.status == 'baru');
    }

    // ── Agenda Desa ──
    match /agenda/{id} {
      allow read: if login();
      allow create, delete: if isStaff();
      allow update: if isStaff()
        || (login() && aktif()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['rsvp_hadir', 'rsvp_mungkin', 'rsvp_tidak', 'rsvp_checkin']));
      match /hadir/{uid} {
        allow read: if isStaff() || (login() && request.auth.uid == uid);
        allow create, update: if login() && aktif() && request.auth.uid == uid;
        allow delete: if login() && request.auth.uid == uid;
      }
      match /komentar/{kid} {
        allow read: if login();
        allow create: if login() && aktif() && request.resource.data.uid == request.auth.uid
          && request.resource.data.isi.size() <= 300;
        allow delete: if isStaff() || (login() && resource.data.uid == request.auth.uid);
      }
    }

    // ── SOS, audit, laporan jasa ──
    match /sos/{id} {
      allow create: if login() && request.resource.data.uid == request.auth.uid;
      allow read: if isStaff() || (login() && resource.data.uid == request.auth.uid);
      allow update: if isStaff() || (login() && resource.data.uid == request.auth.uid && (
        // pemilik: perbarui titik GPS / menyatakan sudah aman
        (request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['lat','lng','akurasi','sumber','posisi_at','status','updated_at','jenis','keterangan','foto'])
         && resource.data.status in ['baru','diproses','aman']
         && (request.resource.data.status == resource.data.status
             || request.resource.data.status == 'aman'))
        // pemilik: menilai penanganan setelah ditutup
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating','ulasan'])
            && resource.data.status == 'ditangani'
            && request.resource.data.rating >= 1 && request.resource.data.rating <= 5)));
      // Pembersihan otomatis: hanya riwayat lebih dari 90 hari
      allow delete: if isStaff() && resource.data.created_at < request.time - duration.value(90, 'd');
    }
    match /audit_log/{id} {
      allow read: if isStaff();
      allow create: if login();
      allow update: if false;
      // Log tidak bisa dihapus sebelum 90 hari (anti-manipulasi)
      allow delete: if isStaff() && resource.data.created_at < request.time - duration.value(90, 'd');
    }
    // Laporan jasa: id = idJasa_uidPelapor → satu pelapor satu laporan per jasa
    match /laporan_jasa/{id} {
      allow create: if login()
        && request.resource.data.uid_pelapor == request.auth.uid
        && id == request.resource.data.service_id + '_' + request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ── Laporan konten/profil/chat oleh warga → hanya Admin yang membaca ──
    // id = tipe_targetId_uidPelapor (satu pelapor satu laporan per target)
    match /laporan_konten/{id} {
      allow create: if login()
        && request.resource.data.uid_pelapor == request.auth.uid
        && request.resource.data.status == 'baru'
        && id == request.resource.data.tipe + '_' + request.resource.data.target_id + '_' + request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
    // Riwayat pembekuan / pembukaan akun (catatan Admin)
    match /riwayat_moderasi/{id} {
      allow create, read: if isAdmin();
      allow update, delete: if false;
    }

    // ── Lapak UMKM ──
    // pemilik mengelola lapaknya (tanpa mengubah rating/status Admin);
    // warga lain hanya menaikkan penghitung (rating, dilihat); Admin memoderasi.
    match /lapak_umkm/{id} {
      allow read: if login();
      allow create: if login() && aktif()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'aktif';
      allow update: if login() && (
        isAdmin()
        || (resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.status == resource.data.status
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['rating_total', 'rating_jumlah', 'alasan_admin']))
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rating_total', 'rating_jumlah', 'dilihat']));
      allow delete: if isAdmin();   // pemilik mengajukan hapus (hapus_status), Admin yang menghapus
      match /ulasan/{uid} {
        allow read: if login();
        allow create, update: if login() && aktif() && request.auth.uid == uid
          && request.resource.data.bintang in [1, 2, 3, 4, 5];
        allow delete: if isAdmin();
      }
    }

    // ── Penanda pembersihan otomatis ──
    match /meta/{id} { allow read, write: if isStaff(); }

    // ── Umpan balik / kritik & saran ──
    //  aplikasi → Admin & Kades | admin → Kades | kades → Admin
    match /umpan_balik/{id} {
      allow create: if login() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'baru';
      allow read: if login() && (
          resource.data.uid == request.auth.uid ||
          (isAdmin() && resource.data.target in ['kades', 'aplikasi']) ||
          (isKades() && resource.data.target in ['admin', 'aplikasi']));
      allow update: if login() && (
          (isAdmin() && resource.data.target in ['kades', 'aplikasi']) ||
          (isKades() && resource.data.target in ['admin', 'aplikasi']))
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'ditinjau_oleh', 'ditinjau_at']);
      allow delete: if isStaff() && resource.data.created_at < request.time - duration.value(180, 'd');
    }
  }
}
